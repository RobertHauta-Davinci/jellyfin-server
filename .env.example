# Jellyfin Server Environment Variables
# Copy this file to .env and adjust values for your setup

# User/group IDs — match your host user (run `id` to check)
JELLYFIN_UID=1000
JELLYFIN_GID=1000

# Named Docker volume for media (dev). For prod/cloud, use an external volume or PVC.
MEDIA_VOLUME=jellyfin-media

# Local paths for config and cache (bind mounts)
CONFIG_PATH=./config
CACHE_PATH=./cache
TRANSCODE_PATH=./transcodes

# Published server URL (set when using a reverse proxy)
# JELLYFIN_PUBLISHED_URL=https://jellyfin.example.com

# --- Domain & HTTPS ---

# DuckDNS domain for Jellyfin (used by Caddy for auto-HTTPS)
# DOMAIN=dnserjelly.duckdns.org

# DuckDNS domain for Jellyseerr (separate subdomain, same IP)
# JELLYSEERR_DOMAIN=requests-erjelly.duckdns.org

# DuckDNS updater config (comma-separated subdomains, no .duckdns.org suffix)
# DUCKDNS_SUBDOMAIN=dnserjelly,requests-erjelly
# DUCKDNS_TOKEN=your-duckdns-token-here

# --- Arr Stack ---

# User/group IDs for arr containers (should match JELLYFIN_UID/GID)
PUID=1000
PGID=1000

# Timezone (used by all arr containers)
TZ=America/Toronto

# qBittorrent incoming torrent port (must match OCI security list + iptables)
TORRENT_PORT=56789

# --- Production / Cloud Settings ---

# Oracle Cloud server (for upload.sh and backup.sh)
# SERVER_IP=xxx.xxx.xxx.xxx
# SERVER_USER=jellyfin
